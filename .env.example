ARTEMIS_RUNTIME_BASE_URL=https://runtime.example.com
ARTEMIS_TENANT_ID=tenant_123
ARTEMIS_PROJECT_ID=project_123
ARTEMIS_SDK_CHANNEL_ID=channel_123
ARTEMIS_SDK_CHANNEL_SECRET=replace-with-secret-from-studio

# Microsoft Entra ID (backend app registration)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Comma-separated: api://<client-id>,<client-id>
ENTRA_API_AUDIENCES=api://00000000-0000-0000-0000-000000000000
ENTRA_REQUIRED_SCOPE=access_as_user

# Exact SharePoint origins allowed to call this backend (comma-separated)
SPFX_ALLOWED_ORIGINS=https://yourtenant.sharepoint.com

PORT=10000
